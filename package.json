{
  "name": "sorrylove",
  "version": "1.0.0",
  "description": "A tiny pixel love app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --publish=never"
  },
  "author": "Larissa",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.lari.sorrylove",
    "productName": "SorryLove",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "icon.icns"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "img/**/*",
      "audio/**/*",
      "package.json"
    ]
  }
}
